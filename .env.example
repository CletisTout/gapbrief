# GapBrief Environment Variables
# WICHTIG: Diese Datei ist ein TEMPLATE für .env
# Kopiere diese Datei zu .env und fülle die API-Keys aus!
# .env wird NICHT in Git committed (siehe .gitignore)

# Peec AI MCP API Key (für Gap-Analyse)
PEEC_API_KEY=your_peec_api_key_here

# Firecrawl API Key (für Content-Scraping & Pattern-Extraction)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: Anthropic API Key (für Claude API Calls)
# Nur benötigt wenn Claude API direkt aufgerufen wird
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
